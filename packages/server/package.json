{
  "name": "@wb/server",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" } },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "cd dist && node --test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate.cjs"
  },
  "dependencies": {
    "@wb/contracts": "workspace:*",
    "drizzle-orm": "0.45.3",
    "postgres": "3.4.9"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "drizzle-kit": "0.31.11",
    "typescript": "^5.6.0"
  }
}
