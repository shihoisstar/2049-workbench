{
  "name": "@wb/contracts",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "node scripts/build.cjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
