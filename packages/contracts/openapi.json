              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StoreOrders"
                }
              }
            }
          }
        }
      }
    },
    "/v1/store/orders/{id}/dev-pay": {
      "post": {
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "summary": "DEV-ONLY:模拟支付回调(NODE_ENV=production 时 404;真实微信回调随商户号)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "订单已支付并入账",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StoreOrder"
                }
              }
            }
          }
        }
      }
    },
    "/v1/templates": {
      "get": {
        "summary": "模板 feed(T3.2 首页;生成同款→预填创作表单)",
        "responses": {
          "200": {
            "description": "模板列表",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Templates"
                }
              }
            }
          }
        }
      }
    },
    "/v1/feedback": {
      "post": {
        "summary": "提交用户反馈(OPS-01;落库后运营可见)",
