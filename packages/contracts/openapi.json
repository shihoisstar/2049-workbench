{
  "openapi": "3.1.0",
  "info": {
    "title": "2049出片 API",
    "version": "v1",
    "description": "契约唯一事实源 @wb/contracts 生成;禁止手改 openapi.json。"
  },
  "servers": [
    {
      "url": "/",
      "description": "相对路径,按部署环境替换"
    }
  ],
  "paths": {
    "/healthz": {
      "get": {
        "summary": "存活探测(LB / CI)",
        "responses": {
          "200": {
            "description": "健康",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/guest": {
      "post": {
        "summary": "游客登录(实现:T1.1 Fastify)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GuestLoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "会话签发",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GuestSession"
                }
              }
            }
          },
          "400": {
            "description": "参数校验失败",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/deactivate": {
      "post": {
        "summary": "账号注销(软删除;实现:T1.1)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "204": {
            "description": "已注销"
          },
          "401": {
            "description": "未登录/凭证失效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/v1/wallet": {
      "get": {
        "summary": "钱包概览:余额+最近流水(实现:T1.2)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "余额与流水",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WalletSummary"
                }
              }
            }
          },
          "401": {
            "description": "未登录",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/v1/store/packages": {
      "get": {
        "summary": "充值档位列表(T1.4)",
        "responses": {
          "200": {
            "description": "档位",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StorePackages"
                }
              }
            }
          }
        }
      }
    },
    "/v1/store/orders": {
      "post": {
        "summary": "创建充值订单(T1.4;微信支付参数随商户号接入,当前阻塞墙)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateOrderRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "订单已创建",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StoreOrder"
                }
              }
            }
          },
          "401": {
            "description": "未登录",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      },
      "get": {
        "summary": "我的订单列表(T1.4)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "订单",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StoreOrders"
                }
              }
            }
          }
        }
      }
    },
    "/v1/store/orders/{id}/dev-pay": {
      "post": {
        "summary": "DEV-ONLY:模拟支付回调(NODE_ENV=production 时 404;真实微信回调随商户号)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "订单已支付并入账",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StoreOrder"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "StorePackages": {
        "type": "object",
        "properties": {
          "packages": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                },
                "credits": {
                  "type": "integer",
                  "exclusiveMinimum": true,
                  "minimum": 0
                },
                "priceCents": {
                  "type": "integer",
                  "exclusiveMinimum": true,
                  "minimum": 0
                }
              },
              "required": [
                "id",
                "label",
                "credits",
                "priceCents"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "packages"
        ],
        "additionalProperties": false
      },
      "CreateOrderRequest": {
        "type": "object",
        "properties": {
          "packageId": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "packageId"
        ],
        "additionalProperties": false
      },
      "StoreOrder": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "packageId": {
            "type": "string"
          },
          "credits": {
            "type": "integer",
            "exclusiveMinimum": true,
            "minimum": 0
          },
          "priceCents": {
            "type": "integer",
            "exclusiveMinimum": true,
            "minimum": 0
          },
          "status": {
            "type": "string",
            "enum": [
              "created",
              "paid",
              "closed"
            ]
          },
          "createdAt": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "packageId",
          "credits",
          "priceCents",
          "status",
          "createdAt"
        ],
        "additionalProperties": false
      },
      "StoreOrders": {
        "type": "object",
        "properties": {
          "orders": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "packageId": {
                  "type": "string"
                },
                "credits": {
                  "type": "integer",
                  "exclusiveMinimum": true,
                  "minimum": 0
                },
                "priceCents": {
                  "type": "integer",
                  "exclusiveMinimum": true,
                  "minimum": 0
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "created",
                    "paid",
                    "closed"
                  ]
                },
                "createdAt": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "packageId",
                "credits",
                "priceCents",
                "status",
                "createdAt"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "orders"
        ],
        "additionalProperties": false
      },
      "WalletSummary": {
        "type": "object",
        "properties": {
          "balance": {
            "type": "integer",
            "minimum": 0
          },
          "entries": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "billingKey": {
                  "type": "string"
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "hold",
                    "settle",
                    "refund",
                    "grant"
                  ]
                },
                "amount": {
                  "type": "integer"
                },
                "remark": {
                  "type": "string",
                  "nullable": true
                },
                "createdAt": {
                  "type": "string"
                }
              },
              "required": [
                "billingKey",
                "type",
                "amount",
                "remark",
                "createdAt"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "balance",
          "entries"
        ],
        "additionalProperties": false
      },
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "degraded"
            ]
          },
          "apiVersion": {
            "type": "string",
            "enum": [
              "v1"
            ]
          },
          "uptimeSec": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "status",
          "apiVersion",
          "uptimeSec"
        ],
        "additionalProperties": false
      },
      "ErrorBody": {
        "type": "object",
        "properties": {
          "code": {
            "type": "number",
            "enum": [
              1000,
              1001,
              1002,
              1003,
              2001,
              2002,
              2003,
              3001,
              3002,
              3003,
              3004,
              4001,
              4002,
              4003,
              5001,
              5002
            ]
          },
          "message": {
            "type": "string"
          },
          "requestId": {
            "type": "string"
          },
          "details": {}
        },
        "required": [
          "code",
          "message"
        ],
        "additionalProperties": false
      },
      "GuestLoginRequest": {
        "type": "object",
        "properties": {
          "deviceId": {
            "type": "string",
            "minLength": 8,
            "maxLength": 64
          }
        },
        "required": [
          "deviceId"
        ],
        "additionalProperties": false
      },
      "GuestSession": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "minLength": 1
          },
          "userId": {
            "type": "string",
            "minLength": 1
          },
          "expiresInSec": {
            "type": "integer",
            "exclusiveMinimum": true,
            "minimum": 0
          }
        },
        "required": [
          "token",
          "userId",
          "expiresInSec"
        ],
        "additionalProperties": false
      }
    }
  }
}
