  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      },
      "opaqueSession": {
        "type": "http",
        "scheme": "bearer",
        "description": "V2服务端存储哈希的不透明会话，非JWT"
      }
    },
    "schemas": {
      "MediaAccess": {
        "type": "object",
        "properties": {
          "assetId": {
            "type": "string",
            "format": "uuid"
          },
          "jobId": {
            "type": "string",
            "format": "uuid"
          },
          "url": {
