{
  "openapi": "3.1.0",
  "info": {
    "title": "2049出片 API",
    "version": "v1",
    "description": "契约唯一事实源 @wb/contracts 生成;禁止手改 openapi.json。"
  },
  "servers": [
    {
      "url": "/",
      "description": "相对路径,按部署环境替换"
    }
  ],
  "paths": {
    "/healthz": {
      "get": {
        "summary": "存活探测(LB / CI)",
        "responses": {
          "200": {
            "description": "健康",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/guest": {
      "post": {
        "summary": "游客登录(实现:T1.1 Fastify)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GuestLoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "会话签发",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GuestSession"
                }
              }
            }
          },
          "400": {
            "description": "参数校验失败",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/deactivate": {
      "post": {
        "summary": "账号注销(软删除;实现:T1.1)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "204": {
            "description": "已注销"
          },
          "401": {
            "description": "未登录/凭证失效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/v1/uploads": {
      "post": {
        "summary": "上传参考图(V1 传图生成;multipart 字段 file,≤10M,jpg/png/webp)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary"
                  }
                },
                "required": [
                  "file"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "上传完成",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UploadResult"
                }
              }
            }
          }
        }
      }
    },
    "/v1/wallet": {
      "get": {
        "summary": "钱包概览:余额+最近流水(实现:T1.2)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "余额与流水",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WalletSummary"
                }
              }
            }
          },
          "401": {
            "description": "未登录",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/v1/store/packages": {
      "get": {
        "summary": "充值档位列表(T1.4)",
        "responses": {
          "200": {
            "description": "档位",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StorePackages"
                }
              }
            }
          }
        }
      }
    },
    "/v1/store/orders": {
      "post": {
        "summary": "创建充值订单(T1.4;微信支付参数随商户号接入,当前阻塞墙)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateOrderRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "订单已创建",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StoreOrder"
                }
              }
            }
          },
          "401": {
            "description": "未登录",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      },
      "get": {
        "summary": "我的订单列表(T1.4)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "订单",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StoreOrders"
                }
              }
            }
          }
        }
      }
    },
    "/v1/store/orders/{id}/dev-pay": {
      "post": {
        "summary": "DEV-ONLY:模拟支付回调(NODE_ENV=production 时 404;真实微信回调随商户号)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "订单已支付并入账",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StoreOrder"
                }
              }
            }
          }
        }
      }
    },
    "/v1/templates": {
      "get": {
        "summary": "模板 feed(T3.2 首页;生成同款→预填创作表单)",
        "responses": {
          "200": {
            "description": "模板列表",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Templates"
                }
              }
            }
          }
        }
      }
    },
    "/v1/feedback": {
      "post": {
        "summary": "提交用户反馈(OPS-01;落库后运营可见)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateFeedbackRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "已受理",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FeedbackCreated"
                }
              }
            }
          }
        }
      }
    },
    "/v1/tasks": {
      "post": {
        "summary": "创建生成任务(冻结估算积分并入队;实现:T2.2)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateTaskRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "任务已受理",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GenerationTask"
                }
              }
            }
          },
          "402": {
            "description": "积分不足",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      },
      "get": {
        "summary": "我的任务列表",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "任务列表",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GenerationTasks"
                }
              }
            }
          }
        }
      }
    },
    "/v1/tasks/{id}": {
      "get": {
        "summary": "任务详情(进度轮询)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "任务",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GenerationTask"
                }
              }
            }
          }
        }
      }
    },
    "/v1/tasks/{id}/cancel": {
      "post": {
        "summary": "取消任务(失败/取消全额退积分)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "取消后的任务",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GenerationTask"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "UploadResult": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "format": "uri"
          }
        },
        "required": [
          "url"
        ],
        "additionalProperties": false
      },
      "CreateFeedbackRequest": {
        "type": "object",
        "properties": {
          "content": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "contact": {
            "type": "string",
            "maxLength": 100
          }
        },
        "required": [
          "content"
        ],
        "additionalProperties": false
      },
      "FeedbackCreated": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      },
      "Templates": {
        "type": "object",
        "properties": {
          "templates": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "category": {
                  "type": "string"
                },
                "coverGradient": {
                  "type": "string"
                },
                "coverMark": {
                  "type": "string"
                },
                "heat": {
                  "type": "string"
                },
                "promptTemplate": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "title",
                "category",
                "coverGradient",
                "coverMark",
                "heat",
                "promptTemplate"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "templates"
        ],
        "additionalProperties": false
      },
      "CreateTaskRequest": {
        "type": "object",
        "properties": {
          "prompt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 3000
          },
          "imageUrls": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uri"
            },
            "maxItems": 3
          },
          "aspectRatio": {
            "type": "string",
            "enum": [
              "16:9",
              "9:16",
              "1:1"
            ],
            "default": "9:16"
          },
          "resolution": {
            "type": "string",
            "enum": [
              "480p",
              "720p",
              "1080p"
            ],
            "default": "480p"
          },
          "durationSec": {
            "type": "integer",
            "minimum": 3,
            "maximum": 15,
            "default": 5
          }
        },
        "required": [
          "prompt"
        ],
        "additionalProperties": false
      },
      "GenerationTask": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "created",
              "queued",
              "running",
              "succeeded",
              "failed",
              "canceled"
            ]
          },
          "prompt": {
            "type": "string"
          },
          "imageUrls": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "aspectRatio": {
            "type": "string"
          },
          "resolution": {
            "type": "string"
          },
          "durationSec": {
            "type": "integer"
          },
          "estimateCredits": {
            "type": "integer",
            "exclusiveMinimum": true,
            "minimum": 0
          },
          "attempts": {
            "type": "integer",
            "minimum": 0
          },
          "videoUrl": {
            "type": "string",
            "nullable": true
          },
          "errorCode": {
            "type": "integer",
            "nullable": true
          },
          "errorMessage": {
            "type": "string",
            "nullable": true
          },
          "createdAt": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string"
          },
          "finishedAt": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "id",
          "status",
          "prompt",
          "imageUrls",
          "aspectRatio",
          "resolution",
          "durationSec",
          "estimateCredits",
          "attempts",
          "videoUrl",
          "errorCode",
          "errorMessage",
          "createdAt",
          "updatedAt",
          "finishedAt"
        ],
        "additionalProperties": false
      },
      "GenerationTasks": {
        "type": "object",
        "properties": {
          "tasks": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "created",
                    "queued",
                    "running",
                    "succeeded",
                    "failed",
                    "canceled"
                  ]
                },
                "prompt": {
                  "type": "string"
                },
                "imageUrls": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "aspectRatio": {
                  "type": "string"
                },
                "resolution": {
                  "type": "string"
                },
                "durationSec": {
                  "type": "integer"
                },
                "estimateCredits": {
                  "type": "integer",
                  "exclusiveMinimum": true,
                  "minimum": 0
                },
                "attempts": {
                  "type": "integer",
                  "minimum": 0
                },
                "videoUrl": {
                  "type": "string",
                  "nullable": true
                },
                "errorCode": {
                  "type": "integer",
                  "nullable": true
                },
                "errorMessage": {
                  "type": "string",
                  "nullable": true
                },
                "createdAt": {
                  "type": "string"
                },
                "updatedAt": {
                  "type": "string"
                },
                "finishedAt": {
                  "type": "string",
                  "nullable": true
                }
              },
              "required": [
                "id",
                "status",
                "prompt",
                "imageUrls",
                "aspectRatio",
                "resolution",
                "durationSec",
                "estimateCredits",
                "attempts",
                "videoUrl",
                "errorCode",
                "errorMessage",
                "createdAt",
                "updatedAt",
                "finishedAt"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "tasks"
        ],
        "additionalProperties": false
      },
      "StorePackages": {
        "type": "object",
        "properties": {
          "packages": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                },
                "credits": {
                  "type": "integer",
                  "exclusiveMinimum": true,
                  "minimum": 0
                },
                "priceCents": {
                  "type": "integer",
                  "exclusiveMinimum": true,
                  "minimum": 0
                }
              },
              "required": [
                "id",
                "label",
                "credits",
                "priceCents"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "packages"
        ],
        "additionalProperties": false
      },
      "CreateOrderRequest": {
        "type": "object",
        "properties": {
          "packageId": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "packageId"
        ],
        "additionalProperties": false
      },
      "StoreOrder": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "packageId": {
            "type": "string"
          },
          "credits": {
            "type": "integer",
            "exclusiveMinimum": true,
            "minimum": 0
          },
          "priceCents": {
            "type": "integer",
            "exclusiveMinimum": true,
            "minimum": 0
          },
          "status": {
            "type": "string",
            "enum": [
              "created",
              "paid",
              "closed"
            ]
          },
          "createdAt": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "packageId",
          "credits",
          "priceCents",
          "status",
          "createdAt"
        ],
        "additionalProperties": false
      },
      "StoreOrders": {
        "type": "object",
        "properties": {
          "orders": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "packageId": {
                  "type": "string"
                },
                "credits": {
                  "type": "integer",
                  "exclusiveMinimum": true,
                  "minimum": 0
                },
                "priceCents": {
                  "type": "integer",
                  "exclusiveMinimum": true,
                  "minimum": 0
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "created",
                    "paid",
                    "closed"
                  ]
                },
                "createdAt": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "packageId",
                "credits",
                "priceCents",
                "status",
                "createdAt"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "orders"
        ],
        "additionalProperties": false
      },
      "WalletSummary": {
        "type": "object",
        "properties": {
          "balance": {
            "type": "integer",
            "minimum": 0
          },
          "entries": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "billingKey": {
                  "type": "string"
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "hold",
                    "settle",
                    "refund",
                    "grant"
                  ]
                },
                "amount": {
                  "type": "integer"
                },
                "remark": {
                  "type": "string",
                  "nullable": true
                },
                "createdAt": {
                  "type": "string"
                }
              },
              "required": [
                "billingKey",
                "type",
                "amount",
                "remark",
                "createdAt"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "balance",
          "entries"
        ],
        "additionalProperties": false
      },
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "degraded"
            ]
          },
          "apiVersion": {
            "type": "string",
            "enum": [
              "v1"
            ]
          },
          "uptimeSec": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "status",
          "apiVersion",
          "uptimeSec"
        ],
        "additionalProperties": false
      },
      "ErrorBody": {
        "type": "object",
        "properties": {
          "code": {
            "type": "number",
            "enum": [
              1000,
              1001,
              1002,
              1003,
              2001,
              2002,
              2003,
              3001,
              3002,
              3003,
              3004,
              4001,
              4002,
              4003,
              5001,
              5002
            ]
          },
          "message": {
            "type": "string"
          },
          "requestId": {
            "type": "string"
          },
          "details": {}
        },
        "required": [
          "code",
          "message"
        ],
        "additionalProperties": false
      },
      "GuestLoginRequest": {
        "type": "object",
        "properties": {
          "deviceId": {
            "type": "string",
            "minLength": 8,
            "maxLength": 64
          }
        },
        "required": [
          "deviceId"
        ],
        "additionalProperties": false
      },
      "GuestSession": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "minLength": 1
          },
          "userId": {
            "type": "string",
            "minLength": 1
          },
          "expiresInSec": {
            "type": "integer",
            "exclusiveMinimum": true,
            "minimum": 0
          }
        },
        "required": [
          "token",
          "userId",
          "expiresInSec"
        ],
        "additionalProperties": false
      }
    }
  }
}
