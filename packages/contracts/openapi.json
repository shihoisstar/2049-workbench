    "/v1/tasks/{id}/cancel": {
      "post": {
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "summary": "取消任务(失败/取消全额退积分)",
        "security": [
          {
            "bearerAuth": []
