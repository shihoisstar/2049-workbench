    "/v1/tasks": {
      "post": {
        "summary": "创建生成任务(冻结估算积分并入队;实现:T2.2)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateTaskRequest"
              }
