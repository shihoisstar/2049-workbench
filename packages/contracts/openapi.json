    "/v1/tasks/{id}": {
      "get": {
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "summary": "任务详情(进度轮询)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
