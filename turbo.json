{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": { "dependsOn": ["^build"], "outputs": ["dist/**"] },
    "typecheck": { "dependsOn": ["^typecheck", "^build"] },
    "lint": {},
    "test": { "dependsOn": ["build"] },
    "@wb/server#test": { "dependsOn": ["build"], "cache": false, "env": ["WB_NEXT_TEST_DATABASE_URL"] },
    "@wb/api-next#test": { "dependsOn": ["build"], "cache": false, "env": ["WB_NEXT_TEST_DATABASE_URL"] },
    "contract-diff": { "dependsOn": ["build"] },
    "dev": { "cache": false, "persistent": true }
  }
}
