{
  "name": "@wb/api",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "cd dist && node --test",
    "dev": "tsc -p tsconfig.json --watch",
    "start": "node dist/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "start:worker": "node dist/worker-main.js"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/jwt": "^10.2.2",
    "@fastify/static": "^10.1.5",
    "@wb/contracts": "workspace:*",
    "@wb/domain": "workspace:*",
    "@wb/model-gateway": "workspace:*",
    "bullmq": "^6.3.11",
    "dotenv": "^18.0.5",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.12.5",
    "ioredis": "^5.11.1",
    "postgres": "^3.4.9",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "drizzle-kit": "^0.31.11",
    "typescript": "^5.6.0"
  }
}
