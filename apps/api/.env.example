# @wb/api 环境变量样例(复制为 .env 使用;.env 已被 gitignore)
# postgres 端口 5433:避开本机原生 postgresql 服务的 5432(infra/docker-compose 说明)
DATABASE_URL=postgres://wb:wb_dev_only@localhost:5433/workbench
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-in-dev
PORT=3000
# worker 调参(T2.2;默认即开发节奏)
# TASK_POLL_INTERVAL_MS=2000
# TASK_RETRY_BACKOFF_MS=1000
# TASK_SWEEP_INTERVAL_MS=60000
# 火山主通道(未配 KEY 时开发走 mock 通道)
# VOLC_ARK_API_KEY=
# VOLC_SEEDANCE_MODEL=doubao-seedance-2-0-fast
