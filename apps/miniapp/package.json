{
  "name": "@wb/miniapp",
  "version": "0.1.0",
  "private": true,
  "description": "2049出片 Taro 双端壳(weapp+H5 一码双出,T0.2)",
  "scripts": {
    "build:weapp": "taro build --type weapp",
    "build:h5": "taro build --type h5",
    "dev:weapp": "taro build --type weapp --watch",
    "dev:h5": "taro build --type h5 --watch",
    "build": "taro build --type weapp && taro build --type h5",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "echo 'miniapp: 页面测试随功能工单落地'"
  },
  "browserslist": [
    "last 3 versions",
    "Android >= 4.1",
    "ios >= 8"
  ],
  "dependencies": {
    "@babel/runtime": "^7.24.4",
    "@nutui/nutui-react-taro": "3.0.23-cpp",
    "@tarojs/components": "4.3.0",
    "@tarojs/helper": "4.3.0",
    "@tarojs/plugin-framework-react": "4.3.0",
    "@tarojs/plugin-platform-weapp": "4.3.0",
    "@tarojs/react": "4.3.0",
    "@tarojs/runtime": "4.3.0",
    "@tarojs/shared": "4.3.0",
    "@tarojs/taro": "4.3.0",
    "@wb/contracts": "workspace:*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@babel/core": "^7.24.4",
    "@babel/preset-react": "^7.24.0",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.6.3",
    "@tarojs/cli": "4.3.0",
    "@tarojs/plugin-platform-h5": "4.3.0",
    "@tarojs/webpack5-runner": "4.3.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.3",
    "@types/webpack-env": "^1.18.4",
    "babel-preset-taro": "4.3.0",
    "eslint": "^9.39.5",
    "postcss": "^8.4.38",
    "react-refresh": "^0.14.0",
    "sass": "^1.75.0",
    "typescript": "^5.6.0",
    "webpack": "5.91.0"
  }
}
